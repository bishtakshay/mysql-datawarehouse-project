import java.util.LinkedList;
import java.util.Scanner;

// ---------- Step 1: Task class ----------
class Task {
    int taskid;
    String taskName;
    int priority;

    // Constructor: sets the values when a Task is created
    Task(int taskid, String taskName, int priority) {
        this.taskid = taskid;
        this.taskName = taskName;
        this.priority = priority;
    }

    // How a Task looks when printed
    @Override
    public String toString() {
        return "Task ID: " + taskid + " | Name: " + taskName + " | Priority: " + priority;
    }

    // Two tasks are equal if their taskid is the same
    @Override
    public boolean equals(Object obj) {
        if (obj instanceof Task) {
            Task other = (Task) obj;
            return this.taskid == other.taskid;
        }
        return false;
    }
}

// ---------- Step 2: TaskManager class ----------
public class TaskManager {

    static LinkedList<Task> tasks = new LinkedList<>();
    static Scanner sc = new Scanner(System.in);

    // Reads a whole number safely (does not crash if user types letters)
    static int readInt(String message) {
        while (true) {
            System.out.print(message);
            try {
                return Integer.parseInt(sc.nextLine().trim());
            } catch (NumberFormatException e) {
                System.out.println("Please enter numbers only.");
            }
        }
    }

    // 1. Add Task (to the end of the list, taskid must be unique)
    static void addTask() {
        int id = readInt("Enter Task ID: ");

        // contains() uses our equals() method (compares taskid only)
        if (tasks.contains(new Task(id, "", 0))) {
            System.out.println("Error: Task ID already exists!");
            return;
        }

        System.out.print("Enter Task Name: ");
        String name = sc.nextLine();
        int priority = readInt("Enter Priority: ");

        tasks.add(new Task(id, name, priority)); // add() puts it at the end
        System.out.println("Task added successfully.");
    }

    // 2. Remove Task by taskid
    static void removeTask() {
        int id = readInt("Enter Task ID to remove: ");

        Task found = null;
        for (Task t : tasks) {
            if (t.taskid == id) {
                found = t;
            }
        }

        if (found == null) {
            System.out.println("Task not found.");
        } else {
            tasks.remove(found);
            System.out.println("Task removed.");
        }
    }

    // 3. Search Task by taskid (linear search)
    static void searchTask() {
        int id = readInt("Enter Task ID to search: ");

        for (Task t : tasks) {
            if (t.taskid == id) {
                System.out.println("Found -> " + t);
                return; // stop, we found it
            }
        }
        System.out.println("Task not found.");
    }

    // 4. Display all tasks using a for-each loop
    static void displayTasks() {
        if (tasks.isEmpty()) {
            System.out.println("No tasks available.");
            return;
        }
        System.out.println("---- All Tasks ----");
        for (Task t : tasks) {
            System.out.println(t);
        }
    }

    // 5. Process next task (queue behavior: first in, first out)
    static void processTask() {
        Task next = tasks.peek(); // look at the first task (does not remove it)

        if (next == null) {
            System.out.println("No tasks to process.");
        } else {
            System.out.println("Processing -> " + next);
            tasks.poll(); // remove the first task
            System.out.println("Task completed and removed.");
        }
    }

    // ---------- Main method: shows the menu ----------
    public static void main(String[] args) {
        int choice = 0;

        while (choice != 6) {
            System.out.println("\n===== TASK MANAGER =====");
            System.out.println("1. Add Task");
            System.out.println("2. Remove Task");
            System.out.println("3. Search Task");
            System.out.println("4. Display Tasks");
            System.out.println("5. Process Next Task");
            System.out.println("6. Exit");

            choice = readInt("Enter your choice: ");

            if (choice == 1) {
                addTask();
            } else if (choice == 2) {
                removeTask();
            } else if (choice == 3) {
                searchTask();
            } else if (choice == 4) {
                displayTasks();
            } else if (choice == 5) {
                processTask();
            } else if (choice == 6) {
                System.out.println("Goodbye!");
            } else {
                System.out.println("Invalid choice. Try 1 to 6.");
            }
        }
    }
}
